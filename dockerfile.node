# Node image for hosts whose kernel cannot run Bun
FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS builder
WORKDIR /app

ARG TMDBAPIKEY
ENV tmdbApiKey=${TMDBAPIKEY}

# Rewrite the manifest for Node: real better-sqlite3 instead of the bun:sqlite shim, tsx for runtime TypeScript, npm scripts
COPY package.json ./package.json.bak
RUN cat package.json.bak \
    | sed 's|"file:packages/better-sqlite3-bun"|"13.0.3"|' \
    | sed '/"better-sqlite3":/a\    "tsx": "^4.23.13",' \
    | sed 's|bun run build:server|npm run build:server|g' \
    | sed 's|bun run clean:server|npm run clean:server|g' \
    | sed 's|bun run clean:client|npm run clean:client|g' \
    | sed 's|bun run --bun vite build|vite build|g' \
    | sed 's|bun run --bun|npx tsx|g' \
    > package.json

RUN --mount=type=cache,target=/root/.npm \
    HUSKY=0 npm install

COPY vite.config.js tsconfig.json tsconfig.base.json postcss.config.mjs ./
COPY src ./src

RUN --mount=type=cache,target=/app/node_modules/.vite \
    npm run build

# tsx survives the prune because the rewrite above made it a dependency
RUN npm prune --omit=dev && \
    rm -rf node_modules/vite node_modules/rollup \
           node_modules/@rollup \
           node_modules/rolldown node_modules/@rolldown

FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf
WORKDIR /app

# tini reaps zombies as PID 1, wget serves the healthcheck, su-exec drops privileges in the entrypoint
RUN apk add --no-cache tini wget su-exec

# npm and corepack ship vendored CVEs and the runtime only needs node and tsx
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /usr/local/lib/node_modules/corepack /usr/local/bin/corepack

# The base image's node user holds UID 1000, which pulsarr must own for PUID defaults
RUN deluser --remove-home node && \
    delgroup node; \
    addgroup -g 1000 -S pulsarr && \
    adduser -u 1000 -G pulsarr -D -H -s /sbin/nologin pulsarr

COPY package.json ./

COPY --from=builder /app/node_modules ./node_modules

RUN mkdir -p /app/data/db && \
    mkdir -p /app/data/logs && \
    chown -R pulsarr:pulsarr /app/data

COPY --from=builder /app/dist ./dist
COPY migrations ./migrations
COPY docker-entrypoint.node.sh ./docker-entrypoint.sh
RUN chmod +x docker-entrypoint.sh
COPY docker-healthcheck.sh ./
RUN chmod +x docker-healthcheck.sh

COPY LICENSE* ./
COPY README.md ./

# CI passes the secret as TMDBAPIKEY; the app reads tmdbApiKey
ARG TMDBAPIKEY

ENV NODE_ENV=production
ENV tmdbApiKey=${TMDBAPIKEY}

VOLUME ["/app/data"]
EXPOSE 3003

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ./docker-healthcheck.sh

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["./docker-entrypoint.sh"]
