{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "removeComments": true,
    "paths": {
      "@root/*": ["./src/*"],
      "@utils/*": ["./src/utils/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@services/*": ["./src/services/*"]
    }
  },
  "include": ["src/**/*", "config"],
  "exclude": ["src/client/**/*"]
}
