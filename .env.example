# Copy this file to .env and uncomment what you need.
# It lists only the settings that cannot be changed in the web UI.
# Most web UI settings can also be set here, and a variable set here overrides the web UI value on every restart.
# Full list: https://jamcalli.github.io/Pulsarr/installation/environment-variables

# --- Timezone (Docker only) ---
# Only set this when running in a container. Native installs use system timezone.
# TZ=UTC

# --- Server ---
# listenPort=3003
# URL prefix when a reverse proxy serves Pulsarr under a subfolder, e.g. /pulsarr
# basePath=/
# Requests allowed per client per minute
# rateLimitMax=500
# enableRequestLogging=false
# Set false to log only to files
# enableConsoleOutput=true
# Milliseconds to wait for work to finish on shutdown
# closeGraceDelay=10000

# --- Security ---
# Set true only if serving the UI over HTTPS
# cookieSecured=false
# Two Pulsarr instances on one host need different names
# cookieName=pulsarr
# Options: required, requiredExceptLocal, disabled
# authenticationMethod=required
# Comma-separated origins allowed to call the API from a browser, e.g. https://dashboard.example.com
# allowedOrigins=
# Comma-separated hostnames Pulsarr answers to (empty accepts any host), plus the upstream name if your proxy rewrites Host
# allowedHosts=
# Comma-separated extra proxy addresses or CIDR ranges to trust for client IPs, e.g. Cloudflare's 173.245.48.0/20. Private ranges are already trusted
# trustedProxies=
# Set true to let another page, such as a dashboard, embed Pulsarr
# allowIframes=false

# --- Database (SQLite, the default, no config needed) ---
# Native installs manage this automatically via dataDir. Only modify for Docker.
# dbPath=./data/db/pulsarr.db

# --- Database (PostgreSQL, uncomment to use) ---
# dbType=postgres
# dbHost=localhost
# dbPort=5432
# dbName=pulsarr
# dbUser=postgres
# dbPassword=
# Full connection string, used instead of the five settings above
# dbConnectionString=

# --- TMDB ---
# TMDB API read access token. Docker images and native builds include one
# tmdbApiKey=
