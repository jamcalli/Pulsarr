{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "maxSize": 2097152,
    "includes": [
      "**",
      "!**/dist",
      "!**/tests",
      "!**/docs",
      "!**/src/client/dist",
      "!**/src/client/types/api.d.ts",
      "!**/tmp",
      "!**/coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/docs/src/**/*.tsx", "**/docs/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["**/.github/renovate.json"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**/src/client/components/ui/**/*",
        "**/src/client/hooks/**/*"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "noUnusedImports": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "style": {
            "noUselessElse": "off",
            "useSingleVarDeclarator": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/client/**", "!**/src/client/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/client/**/hooks/**/use*",
        "**/src/client/**/*Store.ts",
        "**/src/client/lib/basePath.ts",
        "**/src/client/lib/queryClient.ts",
        "**/src/client/lib/tanstackApi.ts",
        "**/src/client/hooks/arr/instanceMutations.ts",
        "!**/src/client/components/ui/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase"],
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/client/components/**",
        "**/src/client/hooks/**",
        "**/src/client/lib/**",
        "**/src/client/stores/**",
        "**/src/client/layouts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features", "@/features/**", "../**"],
                    "message": "Shared client code cannot depend on a feature; move the shared piece to components/, hooks/ or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/client/features/account/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/account",
                      "!@/features/account/**",
                      "../**"
                    ],
                    "message": "Features cannot import another feature's internals; move the shared piece to components/, hooks/ or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/client/features/auth/**"],
